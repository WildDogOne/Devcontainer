# Copy this file to .env and adjust for this server.

# Host path (absolute or relative to this compose file) with the project code
# Claude Code should work on.
WORKSPACE_DIR=./workspace

# GID of the host's docker socket group - lets the container's `claude` user run
# `docker` commands against the host daemon without sudo. Find it with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Bot token for the Telegram bot plugin (https://core.telegram.org/bots#how-do-i-create-a-bot),
# available inside the container so the plugin can use it without extra setup. Leave unset if
# you're not using that plugin.
TELEGRAM_BOT_TOKEN=

# UID/GID shared by the claude-code and pcloud containers' non-root users, so files either one
# creates under PCLOUD_SYNC_DIR have consistent ownership. Only change these if UID/GID 1000 is
# already taken on the host - if you do, both containers need to be rebuilt.
USER_UID=1000
USER_GID=1000

# Host path (absolute or relative to this compose file) that the pcloud container syncs pCloud
# content into, bind-mounted into both containers (see README for the pcloud service).
PCLOUD_SYNC_DIR=./pcloud_sync

# pCloud account credentials for the pcloud sync container. Required if you use that service.
PCLOUD_USERNAME=