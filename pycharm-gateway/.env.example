# Copy to .env and adjust. Everything here has a working default (see docker-compose.yml)
# and only needs overriding if your layout differs from the common case.

# Directory bind-mounted into the container at the same path, so Gateway can open
# projects by their normal absolute path. Defaults to your whole $HOME; narrow this if
# you'd rather not share all of it (e.g. just your git projects root).
#PROJECTS_DIR=/home/you/Documents/git

# Directory containing the *.pub key(s) allowed to SSH in via Gateway. Defaults to
# ~/.ssh (all your own public keys); point it at a smaller directory if you want to be
# more selective about which key is trusted here.
#GATEWAY_AUTHORIZED_KEYS_DIR=/home/you/.ssh

# Only relevant on native Linux with a running ssh-agent (used for *outbound* git SSH
# auth, unrelated to the Gateway connection itself - see ssh-agent-setup.sh). Usually
# already set in your shell environment; only needed here if compose isn't inheriting it.
#SSH_AUTH_SOCK=/run/user/1000/keyring/ssh
